ANTHROPIC_API_KEY=
ALLOWED_ORIGIN=http://localhost:5173
# when true sends mock api response (fixed palette) instead of using tokens
MOCK_AI=true
DATABASE_URL=postgres://sound_palette_user:yourpassword@localhost:5432/sound_palette?sslmode=disable
# 32+ random bytes, e.g. `openssl rand -base64 32`
JWT_SECRET=
# true only when deployed behind the host's reverse proxy; false locally
TRUST_PROXY=false
# should be set to true in production
COOKIE_SECURE=false